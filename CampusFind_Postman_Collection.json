    {
      "name": "07. Business Rules & Edge Cases (Error Tests)",
      "item": [
        {
          "name": "[Rule 1 Violation] Mark RETURNED directly from AVAILABLE (Expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RETURNED\",\n  \"currentUserId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/found-items/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "found-items", "1", "status"]
            },
            "description": "Tests Rule: A found item cannot be marked 'returned' unless it is first marked 'claimed'. Expected: 400 Bad Request."
          }
        },
        {
          "name": "[Rule 2 Violation] Student tries to update status (Expect 403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLAIMED\",\n  \"currentUserId\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/found-items/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "found-items", "1", "status"]
            },
            "description": "Tests Rule: Only an admin or the reporting staff member can change a found item's status. Student Alice (id 3) is forbidden. Expected: 403 Forbidden."
          }
        },
        {
          "name": "[Input Validation Error] Blank fields & short password (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid-email-address\",\n  \"password\": \"12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Tests Bean Validation: triggers FieldErrors handled by @RestControllerAdvice."
          }
        },
        {
          "name": "[Normal Flow Step 1] Mark CLAIMED by Student Alice (Expect 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLAIMED\",\n  \"currentUserId\": 2,\n  \"claimedByUserId\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/found-items/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "found-items", "1", "status"]
            },
            "description": "Staff John (id 2) marks item as CLAIMED by Alice (id 3). Expected: 200 OK."
          }
        },
        {
          "name": "[Normal Flow Step 2] Mark RETURNED after CLAIMED (Expect 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RETURNED\",\n  \"currentUserId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/found-items/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "found-items", "1", "status"]
            },
            "description": "Staff John (id 2) marks already-claimed item as RETURNED. Expected: 200 OK."
          }
        }
      ]
    }
